# ─────────────────────────────────────────────────────────────────────────
#  Copy this file to `.env` and fill in your keys.  DO NOT commit `.env`.
#
#  ⚠️  IMPORTANT: This app is deployed as a STATIC site (GitHub Pages), so any
#  VITE_* value below is BAKED INTO THE PUBLIC JS BUNDLE and is visible to
#  anyone who opens the site. Use restricted / throwaway keys and revoke them
#  after the hackathon. For production you'd proxy these through a backend.
# ─────────────────────────────────────────────────────────────────────────

# ── ElevenLabs (the tutor's voice + ears + the Assemble puzzle's sound cues) ──
# The same key drives all three: text-to-speech (tts.js), speech-to-text via
# Scribe (stt.js), and sound generation for the snap / reject / dismantle cues
# (sfx.js). Without it the voice falls back to browser speech, the mic to DGPT
# Whisper (or Web Speech), and the cues to a WebAudio synth — the app still works.
VITE_ELEVENLABS_API_KEY=
# Voice id — default is "Rachel" (a stock ElevenLabs voice). Pick any from your
# ElevenLabs Voices page. https://elevenlabs.io/app/voice-library
VITE_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# TTS model — eleven_flash_v2_5 is the lowest-latency ElevenLabs model and
# still multilingual (good for German + English). eleven_turbo_v2_5 sounds a
# touch richer but adds a few hundred ms before the tutor starts talking.
VITE_ELEVENLABS_MODEL=eleven_flash_v2_5
# STT model for the mic — scribe_v2 (ElevenLabs Scribe v2) is the default and
# is the primary transcription path; DGPT Whisper below is the fallback.
VITE_ELEVENLABS_STT_MODEL=scribe_v2

# ── DeutschlandGPT (the AI tutor brain) ──
# Docs: https://titanom.deutschlandgpt.de/docs/platform-api/createChatCompletion
# NOTE: DeutschlandGPT has NO CORS, so a browser can't call it directly.
#   • Local dev: just set the key below — Vite proxies /dgpt-api for you.
#   • Deployed site: deploy the Cloudflare Worker in ../worker and set
#     VITE_DGPT_BASE_URL to its URL (the Worker holds the key — see worker/README.md).
VITE_DGPT_API_KEY=
# Leave BASE_URL empty for local dev (uses the Vite proxy). For the deployed
# site, set it to your Worker URL, e.g. https://dgpt-proxy.you.workers.dev
VITE_DGPT_BASE_URL=
# Optional model id: claude-4.5-sonnet | gpt-4o | gemini-2.5-flash
VITE_DGPT_MODEL=claude-4.5-sonnet
# Model for the Fix planner only — a one-shot structured task where quality
# beats latency, so it defaults to the strongest tier. Falls back to
# VITE_DGPT_MODEL automatically if a call to it fails.
VITE_DGPT_PLAN_MODEL=claude-opus-5
# Model for the home screen's object scan (camera photo → chair/bicycle/bed/none).
# MUST be multimodal. Defaults to VITE_DGPT_MODEL, which is — only set this if
# you point that at a text-only model.
VITE_DGPT_VISION_MODEL=
# FALLBACK speech-to-text model (POST /v2/audio/transcriptions), used only when
# no ElevenLabs key is set or Scribe fails. whisper-1 works on every key;
# alternatives: voxtral-mini-2507, chirp-3, scribe_v1/v2 (may need extra
# permissions on your key).
VITE_DGPT_STT_MODEL=whisper-1

# ── Langfuse (observability: traces voice, AI answers, modes, AR, TTS) ──
# Get keys from your Langfuse project → Settings → API Keys.
# Unlike the keys above, these are NEVER bundled into the client:
#   • Local dev: set the two keys below (no VITE_ prefix). The Vite proxy signs
#     requests server-side, so the browser sends telemetry credential-free.
#   • Deployed site: leave these blank; put them in the Cloudflare Worker as
#     secrets (see worker/README.md) and set VITE_LANGFUSE_BASE_URL instead.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse Cloud region: https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US)
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Deployed site only: your Worker's /langfuse route, e.g.
#   https://dgpt-proxy.you.workers.dev/langfuse
# Leave empty for local dev (uses the Vite proxy). Empty ⇒ telemetry disabled in prod.
VITE_LANGFUSE_BASE_URL=
